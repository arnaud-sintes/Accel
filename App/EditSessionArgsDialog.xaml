<Window x:Class="Accel.App.EditSessionArgsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Accel.App.Controls"
        Title="Edit launch args" Height="360" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" Style="{StaticResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>
    <!-- Same elevation ladder as CreateSessionDialog/RenameSessionDialog. -->
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True" Background="{StaticResource SurfaceBrush}">
        <controls:CustomTitleBar DockPanel.Dock="Top" TitleText="Edit launch args"
                                  ShowMinimizeButton="False" ShowMaximizeButton="False" />
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                A resumed session's model/effort/cwd already come from its own transcript - this
                dialog deliberately offers only the flags a resume can still meaningfully change,
                applied the next time this session is resumed (plain or fork), never to an
                already-running `claude` process (its argv cannot change once launched).
            -->
            <TextBlock Grid.Row="0" Text="These flags are added the next time this session is resumed. Model and effort cannot be changed for an existing session."
                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16" />

            <!--
                Single line: label followed inline by the combo - see CreateSessionDialog.xaml's
                identical control for why (SelectedItem, and an explicit ItemTemplate rather than
                DisplayMemberPath - the latter was found to leave the closed-box display showing the
                choice record's own ToString() with this app's custom ComboBox template). Only ever
                added to the resume as a permission-mode flag when the choice differs from "Default" -
                see App/Services/CommonCliFlags.cs.
            -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Permission mode:" Style="{StaticResource FieldLabelTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="PermissionModeComboBox"
                          ItemsSource="{Binding PermissionModeChoices}"
                          SelectedItem="{Binding SelectedPermissionModeChoice}"
                          MinWidth="200" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Extra CLI arguments (advanced)" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBlock x:Name="ExtraArgsWarningText" Grid.Row="3"
                       Foreground="{StaticResource DangerBrush}" FontWeight="Bold" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeCaption}" Margin="0,0,0,8" />
            <TextBox x:Name="ExtraArgsBox" Grid.Row="4"
                     Text="{Binding ExtraArgsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False"
                     FontFamily="{StaticResource FontFamilyMono}"
                     ToolTip="e.g. --add-dir C:\some\path"
                     Margin="0,0,0,16" VerticalAlignment="Top" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}"
                        MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" IsDefault="True" />
            </StackPanel>
        </Grid>
    </DockPanel>
    </Border>
</Window>
