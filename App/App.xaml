<Application x:Class="Accel.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Deliberately NOT an ApplicationDefinition in the build sense (see Accel.csproj's
        ItemGroup for App/App.xaml, and the comment on the Accel.App.App partial class):
        Program.cs's top-level-statements Main is the one and only process entry point. If this
        file compiled with the SDK's default ApplicationDefinition build action, the WPF SDK
        would generate a second Main (from this file's StartupUri/Main-generation logic),
        colliding with the existing one and failing the build. It is compiled as Page instead,
        and Accel.App.App is constructed manually by Program.cs's RunCombinedAsync - the app's
        one and only real startup path.

        Resources are the app-wide dark theme, defined in the standalone App/Theme.xaml
        ResourceDictionary and merged in here (as well as directly into every Window's own
        Resources - see Theme.xaml's doc comment for why each Window carries its own copy rather
        than relying solely on Application.Resources). This only works because App.xaml.cs's
        constructor explicitly calls InitializeComponent() - without that call, nothing in here
        would ever load (this class isn't built as ApplicationDefinition, so there's no
        SDK-generated Main to do it implicitly).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
