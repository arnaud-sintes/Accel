<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!--
        The app-wide dark theme: a design system (colors, type scale, spacing, radii) plus implicit
        (TargetType-only, no x:Key) control styles/templates and a handful of keyed variants.
        Kept as a standalone ResourceDictionary (rather than living directly in
        Application.Resources) and merged into BOTH App.xaml AND every Window's own Resources
        (MainWindow.xaml, CreateSessionDialog.xaml, RenameSessionDialog.xaml) so a Window resolves
        its own styling even when constructed without Application.Current ever being set - e.g.
        CreateSessionDialogTests constructs CreateSessionDialog directly on an STA thread with no
        Accel.App.App instance, so StaticResource lookups that only reached up to
        Application.Resources would fail there.

        Every control here gets a REAL ControlTemplate, not just Background/Foreground setters -
        this is what removes the native Windows chrome (scrollbar arrows/track, menu dropdown
        chevrons, combo box toggle button, tree expand/collapse triangle) rather than just
        recoloring it.

        ============================ DESIGN SYSTEM ============================
        Reference feel: Linear / Raycast / Warp - true-black base, layered elevation, generous
        spacing, soft strokes instead of hard 1px gray chrome, rounded corners everywhere.

        Elevation ladder (background):
          L0 base      #0A0A0A  window / terminal surface
          L1 surface   #121212  side panels
          L2 elevated  #191919  title bar, tab strip, cards, inputs
          L3 overlay   #212121  popups, menus, tooltips, dialogs' raised bits
          hover overlay #2A2A2A / pressed #333333

        Accents:
          Primary   pastel orange  #F0A868  (hover #F7BE86, pressed #D28F52, tint 15%/25%)
          Complement teal-blue     #6EC1D6  (hover #90D4E4, pressed #4E9CB0, tint 15%/25%)

        Type scale (Segoe UI Variable Text -> Segoe UI):
          Caption 12 / Body 14 / BodyLarge 15 / Subtitle 17 / Title 20; mono = Cascadia Code.

        Spacing grid: 4 / 8 / 12 / 16 / 24.
        Radius scale: 4 small controls, 6 rows/inputs, 8 cards/dialogs/popups, 12 outer window.
        ======================================================================
    -->

    <!-- ==================== COLORS ==================== -->
    <Color x:Key="BackgroundBaseColor">#FF0A0A0A</Color>
    <Color x:Key="SurfaceColor">#FF121212</Color>
    <Color x:Key="SurfaceElevatedColor">#FF191919</Color>
    <Color x:Key="SurfaceOverlayColor">#FF212121</Color>
    <Color x:Key="SurfaceHoverColor">#FF2A2A2A</Color>
    <Color x:Key="SurfacePressedColor">#FF333333</Color>

    <Color x:Key="StrokeSubtleColor">#FF1F1F1F</Color>
    <Color x:Key="StrokeColor">#FF2B2B2B</Color>
    <Color x:Key="StrokeStrongColor">#FF3A3A3A</Color>

    <Color x:Key="TextPrimaryColor">#FFF2F2F2</Color>
    <Color x:Key="TextSecondaryColor">#FFA9A9A9</Color>
    <Color x:Key="TextMutedColor">#FF6E6E6E</Color>
    <Color x:Key="TextDisabledColor">#FF555555</Color>

    <!-- Primary accent: pastel orange (soft, desaturated - never neon). -->
    <Color x:Key="AccentColor">#FFF0A868</Color>
    <Color x:Key="AccentHoverColor">#FFF7BE86</Color>
    <Color x:Key="AccentPressedColor">#FFD28F52</Color>
    <Color x:Key="AccentTintColor">#26F0A868</Color>
    <Color x:Key="AccentTintStrongColor">#40F0A868</Color>

    <!-- Complementary accent: teal-blue. -->
    <Color x:Key="TealColor">#FF6EC1D6</Color>
    <Color x:Key="TealHoverColor">#FF90D4E4</Color>
    <Color x:Key="TealPressedColor">#FF4E9CB0</Color>
    <Color x:Key="TealTintColor">#266EC1D6</Color>
    <Color x:Key="TealTintStrongColor">#406EC1D6</Color>

    <Color x:Key="DangerColor">#FFE98F8F</Color>
    <Color x:Key="WarningColor">#FFE8C07D</Color>
    <Color x:Key="SuccessColor">#FF8FCB9B</Color>

    <!-- ==================== BRUSHES ==================== -->
    <!--
        The legacy key names (WindowBackgroundBrush / PanelBackground* / BorderBrush / Accent* /
        Selection* ...) are kept on purpose: every XAML in the app already consumes them, so
        re-pointing them at the new palette re-skins everything without churning call sites.
    -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundBaseColor}" />
    <SolidColorBrush x:Key="BackgroundBaseBrush" Color="{StaticResource BackgroundBaseColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelBackgroundElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
    <SolidColorBrush x:Key="PanelBackgroundHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{StaticResource StrokeSubtleColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="SplitterBrush" Color="{StaticResource StrokeSubtleColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="AccentTintStrongBrush" Color="{StaticResource AccentTintStrongColor}" />
    <!-- Legacy alias: was the "pressed / secondary accent fill" colour. -->
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentPressedColor}" />
    <!-- Text/icon colour to place ON a filled orange accent surface (near-black, AA on pastel). -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0A0A0A" />

    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource TealHoverColor}" />
    <SolidColorBrush x:Key="TealPressedBrush" Color="{StaticResource TealPressedColor}" />
    <SolidColorBrush x:Key="TealTintBrush" Color="{StaticResource TealTintColor}" />
    <SolidColorBrush x:Key="TealTintStrongBrush" Color="{StaticResource TealTintStrongColor}" />
    <SolidColorBrush x:Key="OnTealBrush" Color="#FF0A0A0A" />

    <!-- Selected row fill: the teal tint, so selection reads distinctly from the orange hover/primary. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource TealTintStrongColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FF241B10" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FF5E4523" />

    <!-- Accent progression used by the effort bars (orange -> teal reads as "more effort"). -->
    <LinearGradientBrush x:Key="AccentProgressionBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource TealColor}" />
    </LinearGradientBrush>

    <!-- ==================== TYPOGRAPHY ==================== -->
    <FontFamily x:Key="FontFamilyBase">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">17</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>

    <!-- ==================== SPACING / RADII ==================== -->
    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingSm">8</Thickness>
    <Thickness x:Key="SpacingMd">12</Thickness>
    <Thickness x:Key="SpacingLg">16</Thickness>
    <Thickness x:Key="SpacingXl">24</Thickness>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">12</CornerRadius>

    <!-- Soft, wide, low-opacity shadow - depth without the old harsh drop shadow. -->
    <DropShadowEffect x:Key="ElevationOverlayShadow" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.55" Color="#FF000000" />

    <!-- ==================== TEXT STYLES ==================== -->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Section header: small, uppercase-ish, tracked out - the Linear/Raycast panel-header look. -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Form field label above a TextBox/ComboBox in the dialogs. -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ==================== WINDOW ==================== -->
    <!--
        Custom window chrome: WindowStyle="None" removes the native title bar entirely, and the
        WindowChrome attached property re-adds resize-border hit-testing (ResizeBorderThickness)
        and a caption-drag region (CaptionHeight, matching CustomTitleBar's own Height) without any
        native glass/buttons (GlassFrameThickness="0", UseAeroCaptionButtons="False") - see
        App/Controls/CustomTitleBar.xaml for the replacement title bar this relies on, and
        MainWindow.xaml.cs's WindowProc hook for the maximize-to-work-area fix a
        borderless+maximizable window needs (WM_GETMINMAXINFO + maximized WM_NCCALCSIZE).

        CornerRadius="8" asks DWM for a rounded window frame; on Windows 11 that lands, and on
        Windows 10 (the repo's documented support floor, README.md) it is simply ignored rather
        than breaking - which is why AllowsTransparency stays False (turning it on would cost
        hardware acceleration for the whole window, including the WebView2 terminal).

        FontFamily lists "Segoe UI Variable Text" first (Windows 11's modern UI font) with plain
        "Segoe UI" as an explicit fallback - Segoe UI Variable isn't guaranteed present on
        Windows 10, so WPF's normal font-fallback (rather than a single hard-coded name) keeps that
        floor working. Base size is 14 (not WPF's 12) for the modern web-app density this UI wants.
    -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="False" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                                     GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== MENU ==================== -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}" />
    </Style>

    <!--
        One template covers every MenuItem role - top-level bar items (File/Session/View/Help),
        their dropdown leaf items, AND every ContextMenu's items (a ContextMenu's entries are
        MenuItems too) - so there is exactly one flat/modern menu look, not two independently
        maintained ones. No app menu is currently checkable (no IsCheckable="True" anywhere), so
        there is deliberately no checkmark column/glyph to template.

        Hover uses the pastel-orange tint plus an orange label, so the accent (not a gray box)
        is what reads as "this is the live item".
    -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,7" />
        <!--
            A Popup (every ContextMenu, and every MenuItem submenu) opens its own PresentationSource
            with its own visual-tree root - it does NOT inherit property-value-inheritance from the
            main window (TextOptions.* included), so without setting these explicitly here every
            popup menu quietly falls back to WPF's per-pixel/system-default text rendering instead of
            the ClearType + "Ideal" formatting Theme.xaml's Window style uses everywhere else. That
            mismatch is what read as "blurry and a different font" next to e.g. panel A's status text.
        -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                                   VerticalAlignment="Center" />
                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE970;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="20,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsSubmenuOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceOverlayBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="6" Margin="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                                                      Opacity="0.55" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Popup" Property="Placement" Value="Right" />
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceOverlayBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- See the MenuItem style above for why a Popup root needs these set explicitly. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="6" Margin="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
    </Style>

    <!-- ==================== BUTTONS ==================== -->
    <!--
        Default (implicit) button = the neutral/secondary one: elevated surface, soft stroke,
        teal-tinted hover. Two keyed variants sit on top of it:
          PrimaryButtonStyle   - filled pastel orange, near-black label (the confirm action)
          SecondaryButtonStyle - teal outline (the "other" emphasised action)
          SubtleButtonStyle    - no chrome until hovered (icon/inline actions, e.g. a tab's close ✕)
        Every one shares the same 6px radius, 36px min height (comfortable hit target) and
        FontSizeBody, so they line up in a row without per-call-site padding tweaks.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TealTintBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource TealBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TealHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TealTintStrongBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource TealPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TealPressedBrush}" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- ==================== TEXT INPUT ==================== -->
    <!--
        Retemplated (not just recoloured) so the input gets the 6px radius and a real focus ring:
        the border switches to pastel orange on focus, which is the single strongest "you are
        typing here" cue in the whole UI.
    -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== COMBO BOX ==================== -->
    <!-- Flat dropdown-button + popup, no native combo-box bevel/arrow-button chrome. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- See the MenuItem style above for why a Popup root (the dropdown below) needs these set
             explicitly - without them the dropdown's item text renders blurry/mismatched next to
             the rest of the app, since it opens its own PresentationSource. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="6" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource TealBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Popup x:Name="Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300"
                                    Background="{StaticResource SurfaceOverlayBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="6" Margin="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                                                      Opacity="0.55" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selected/hovered combo-box list rows, styled the same as every other flat list row. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LISTS ==================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!--
        Rounded row with a hover/selected fill, plus a left accent bar on the selected row - the
        selected state therefore survives a colour-blind/high-contrast reading (bar present or
        absent), not only the teal tint.
    -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2"
                                    Margin="0,4" Background="Transparent" />
                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TREE ==================== -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!--
        Rotating chevron instead of the native triangle. Kept under its stock key name
        (ExpandCollapseToggleStyle) as well as being referenced explicitly by the TreeViewItem
        template below, so it applies either way.
    -->
    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="20" Height="24" Background="Transparent">
                        <Path x:Name="Chevron" Data="M 0 0 L 4.5 4.5 L 0 9" Fill="Transparent"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Full TreeViewItem template (the stock WPF shape: expander column + header border +
        indented ItemsPresenter). Retemplating rather than only recolouring is what makes hover
        correct: TreeViewItem.IsMouseOver is also true while the pointer is over a CHILD row, so a
        Style trigger on it would light up every ancestor. The trigger below is on the header
        Border's own IsMouseOver instead, which is true only over that one row.

        Selected rows get the teal tint plus an orange left bar; hovered rows get the neutral
        elevation overlay - so hover and selection never read as the same thing.
    -->
    <Style TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="20" Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" ClickMode="Press"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ExpandCollapseToggleStyle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Margin="0,1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2"
                                        Margin="0,3" Background="Transparent" />
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SPLITTER ==================== -->
    <!--
        Hairline at rest, pastel orange while hovered/dragged: the splitter stops being a permanent
        gray bar and instead only announces itself when it is the thing being touched.
    -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource SplitterBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TOOLTIP ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceOverlayBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" MaxWidth="420">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SCROLLBARS ==================== -->
    <!-- Shared thumb look for both scrollbar orientations - a thin rounded bar that warms to the accent on drag. -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{StaticResource TextMutedBrush}"
                            CornerRadius="4" Opacity="0.35" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="TransparentRepeatButtonTemplate" TargetType="RepeatButton">
        <Rectangle Fill="Transparent" />
    </ControlTemplate>

    <!-- No line-up/line-down arrow buttons at all (deliberate - the "modern web/VS Code" scrollbar look). -->
    <ControlTemplate x:Key="ScrollBarVerticalTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" Width="6" MinHeight="28" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBarHorizontalTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" Height="6" MinWidth="28" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A ScrollViewer with both bars visible (e.g. panel A's TreeView, once its content is both
        taller and wider than the viewport) draws its default template's bottom-right "corner" cell
        with SystemColors.ControlBrushKey - a light/white system colour that has nothing to do with
        this theme, so it shows up as a bright square exactly where the two themed (dark, thin)
        scrollbars above meet. Overriding the whole ScrollViewer template just to make that one cell
        transparent (it never needs to be anything else - nothing is ever actually drawn there).
    -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                 Content="{TemplateBinding Content}"
                                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                                 CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="Transparent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== APP-LEVEL COMPOSITES ==================== -->
    <!-- Card/panel surface: elevated fill, hairline stroke, 8px radius. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--
        Tab-strip container style (panel C). Pill-shaped tabs: transparent at rest, elevation
        overlay on hover, pastel-orange tint + orange top bar when selected. MainWindow's own
        ItemContainerStyle derives from this (BasedOn) so it keeps its EventSetter/automation
        setters while inheriting the look.
    -->
    <Style x:Key="TabItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderThickness="0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="AccentBar" Grid.Row="0" CornerRadius="1" Margin="8,0"
                                    Background="Transparent" />
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tab's close (✕) affordance: invisible until the row is hovered, red-tinted on its own hover. -->
    <Style x:Key="TabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
