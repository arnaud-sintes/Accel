<UserControl x:Class="Accel.App.Controls.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!--
        P2-T5: WebView2-hosted xterm.js terminal - renders an inert (no PTY) terminal only. See
        TerminalView.xaml.cs for CoreWebView2 initialization (user-data folder,
        SetVirtualHostNameToFolderMapping, navigation to the vendored index.html). Wiring this up
        to a live claude session over /pty/{tabId} is the separate, later task P2-T5b.
    -->
    <!--
        Theme is merged in here too (not only via App.xaml) for the same reason every Window does
        it - see App/Theme.xaml's doc comment: this control is also constructed by dev verbs /
        tests with no Application.Current, where a lookup that only reached Application.Resources
        would throw.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        Background is the theme's base (L0) black - it is what shows through for the split second
        before WebView2 paints, so it must match wwwroot/xterm/index.html's own body background
        (#0A0A0A) and terminal.js's xterm theme exactly, or the terminal flashes a lighter panel
        on every attach.
    -->
    <Grid Background="{StaticResource BackgroundBaseBrush}">
        <wv2:WebView2 x:Name="Browser" />
    </Grid>
</UserControl>
