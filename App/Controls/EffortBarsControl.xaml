<UserControl x:Class="Accel.App.Controls.EffortBarsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
    <!--
        A single dot gauge next to the model badge: Level 0 (unknown/irrelevant) shows only the
        hollow, unfilled TrackRing outline - "visibly different from no control at all" without
        implying any actual effort value. Level 1-4 (see EffortBarLevel.Resolve) shows a solid
        filled disc colored along a green -> amber -> red ramp (EffortBarsControl.xaml.cs's
        LevelBrush) - low effort reads as calm/green, max effort reads as hot/red, at a glance.
        Colour is not this state's only signal for non-visual users: AutomationProperties.Name
        (set in ApplyLevel) always carries the same "Effort level N of 4"/"unknown" text a screen
        reader or accessibility inspector would use instead of colour.
    -->
    <Grid Width="14" Height="14" VerticalAlignment="Bottom">
        <Ellipse x:Name="TrackRing" Width="12" Height="12" StrokeThickness="2" Fill="Transparent" />
        <Ellipse x:Name="FillDisc" Width="12" Height="12" Visibility="Collapsed" />
    </Grid>
</UserControl>
