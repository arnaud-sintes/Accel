<Window x:Class="Accel.App.RenameSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Accel.App.Controls"
        Title="Rename session" Height="260" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>
    <!-- Same elevation ladder as CreateSessionDialog: L1 surface body under the L2 title bar. -->
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True" Background="{StaticResource SurfaceBrush}">
        <controls:CustomTitleBar DockPanel.Dock="Top" TitleText="Rename session"
                                  ShowMinimizeButton="False" ShowMaximizeButton="False" />
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="NameBox" Grid.Row="1"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />

            <!-- Validation error: an inset danger card, matching CreateSessionDialog's. -->
            <Border Grid.Row="2" Background="#1FE98F8F" BorderBrush="#4DE98F8F" BorderThickness="1"
                    CornerRadius="6" Padding="12,8"
                    Visibility="{Binding Visibility, ElementName=ErrorText}">
                <TextBlock x:Name="ErrorText"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}"
                        MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="RenameButton" Content="Rename" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" IsDefault="True" />
            </StackPanel>
        </Grid>
    </DockPanel>
    </Border>
</Window>
