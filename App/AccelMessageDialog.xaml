<Window x:Class="Accel.App.AccelMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Accel.App.Controls"
        Title="Accel" Height="220" Width="440" MinHeight="180" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" Style="{StaticResource DialogWindowStyle}">
    <!--
        The themed replacement for every native System.Windows.MessageBox.Show call in the app -
        same elevation ladder (Theme.xaml SurfaceBrush body under a CustomTitleBar) as
        CreateSessionDialog/RenameSessionDialog, so a confirm/info/error prompt reads as part of
        Accel rather than as an unstyled Win32 box dropped on top of it. See AccelMessageDialog.xaml.cs
        for the icon/button wiring - this file only lays out the shell.
    -->
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True" Background="{StaticResource SurfaceBrush}">
        <controls:CustomTitleBar x:Name="TitleBar" DockPanel.Dock="Top" TitleText="Accel"
                                  ShowMinimizeButton="False" ShowMaximizeButton="False" />
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="IconText" FontFamily="Segoe MDL2 Assets" FontSize="28"
                           VerticalAlignment="Top" Margin="0,0,16,0" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}"
                           MaxWidth="320" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="NoButton" Content="No" Click="NoButton_Click"
                        MinWidth="88" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="YesButton" Content="Yes" Click="YesButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" />
                <Button x:Name="OkButton" Content="OK" Click="OkButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Grid>
    </DockPanel>
    </Border>
</Window>
