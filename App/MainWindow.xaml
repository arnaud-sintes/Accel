<Window x:Class="Accel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Accel.App.Converters"
        xmlns:controls="clr-namespace:Accel.App.Controls"
        Title="Accel" Height="720" Width="1200" WindowState="Maximized" WindowStyle="None"
        Icon="pack://application:,,,/App/accel.ico">
    <!--
        P1-T4 originally set Language="" here to route around a XamlParseException caused by
        InvariantGlobalization (Accel.csproj) stripping the culture tables FrameworkElement.Language
        needed. InvariantGlobalization was removed instead (see Accel.csproj's comment) once it
        turned out to also crash WPF's keyboard-input pipeline on a non-English keyboard - a much
        more fundamental conflict than the binding-converter symptom this attribute was papering
        over. With real culture data present again, the default Language is fine.
    -->
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Theme.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            P1-T4 / locked-in decision 9: panel A's four IsRunning x IsFocused visual states.
            These brushes' colours must stay in sync with SessionVisualStateResolver's
            *ColorHex constants (the tested, WPF-free single source of truth for the mapping) -
            they are duplicated here rather than referenced via {x:Static} only because
            SolidColorBrush construction from a plain string constant still needs a XAML-side
            colour literal; ModelBadgeTableTests/SessionVisualStateResolverTests pin the C# side
            down, and RootsPanelNodeViewModelTests covers the AutomationDescription text this
            style's Triggers are matched against.
        -->
        <!--
            Phase 7: panel B's git status row template - a path + a single-letter status badge.
            The badge's color is never the only cue (locked-in accessibility rule, §"never
            color-only") - the letter itself (M/A/D/R/C/U/?) and the full status word carried in
            AutomationDescription/ToolTip both stand on their own without the color.
        -->
        <DataTemplate x:Key="GitChangeRowTemplate">
            <!--
                Double-click opens a read-only tab for a new/removed entry (see
                GitPanelEntryViewModel.IsOpenable and MainWindow.GitChangeRow_MouseLeftButtonDown,
                which no-ops for a non-openable status, e.g. Modified/Renamed). This Grid is not a
                Control, so it has no MouseDoubleClick routed event - ClickCount is checked manually
                instead.
            -->
            <Grid Margin="8,3" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding AutomationDescription}"
                  MouseLeftButtonDown="GitChangeRow_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLetter}" Margin="8,0,0,0"
                           FontWeight="Bold" HorizontalAlignment="Center" MinWidth="14"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="M">
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="A">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="D">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="U">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="R">
                                    <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="C">
                                    <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusLetter}" Value="?">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!--
            Panel A's MCP/SKILLS row template - a tool (or skill) name plus its hit count, same
            Star/Auto two-column shape as GitChangeRowTemplate above. The count badge is never the
            only cue (same accessibility rule): AutomationDescription/ToolTip spell "N call(s)" out
            in full, so the badge can be ignored entirely without losing information.
        -->
        <DataTemplate x:Key="ToolUsageRowTemplate">
            <Grid Margin="8,3" ToolTip="{Binding AutomationDescription}"
                  AutomationProperties.Name="{Binding AutomationDescription}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding HitCount}" Margin="8,0,0,0"
                           FontWeight="Bold" HorizontalAlignment="Center" MinWidth="14"
                           VerticalAlignment="Center" Foreground="{StaticResource TealBrush}"
                           Style="{StaticResource SecondaryTextStyle}" />
            </Grid>
        </DataTemplate>

        <SolidColorBrush x:Key="RunningFocusedBrush" Color="#FF4FC3F7" />
        <SolidColorBrush x:Key="RunningBrush" Color="#FF66BB6A" />
        <SolidColorBrush x:Key="IdleFocusedBrush" Color="#FF9FA8DA" />
        <SolidColorBrush x:Key="IdleBrush" Color="#FF9E9E9E" />

        <!--
            "Waiting for feedback" row highlight (RootsPanelNodeViewModel.IsWaiting) - amber, distinct
            from every IsRunning x IsFocused combination above, so a session that just finished its
            turn stands out regardless of its running/focused state. Cleared the instant the user
            focuses that row's tab (RootsPanelViewModel.ApplyFocus), not on a timer.
        -->
        <SolidColorBrush x:Key="WaitingRowBackgroundBrush" Color="#33FFB300" />
        <SolidColorBrush x:Key="WaitingRowBorderBrush" Color="#FFFFB300" />

        <!--
            Never color-only (hard accessibility requirement): FontWeight carries IsFocused
            (Bold vs Normal) independently of the Foreground colour, and the glyph shape below
            (filled vs hollow, driven by its own DataTrigger on IsRunning) carries IsRunning
            independently of both. Removing colour entirely (e.g. a high-contrast theme) still
            leaves all four states distinguishable via glyph shape + weight alone.
        -->
        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRunning}" Value="True" />
                        <Condition Binding="{Binding IsFocused}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource RunningFocusedBrush}" />
                </MultiDataTrigger>
                <!--
                    Running rows are now emphasized (Bold) even when not focused - the bullet glyph
                    that used to be the sole "this is running" signal is gone from the row, so weight
                    (already differing from colour, never colour alone) has to carry that half of the
                    state on its own. Deliberately no Foreground override here (stays the base
                    IdleBrush): green + Bold together over-emphasized these rows relative to the
                    actually-focused session, leaving nothing left to visually distinguish "handled
                    right now by Accel" from merely "running somewhere."
                -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRunning}" Value="True" />
                        <Condition Binding="{Binding IsFocused}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Bold" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRunning}" Value="False" />
                        <Condition Binding="{Binding IsFocused}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource IdleFocusedBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The tree row's name column reuses StateTextStyle's IsRunning x IsFocused styling for
            session/agent rows, plus one more override: a root row's path is always
            IsRunning=False/IsFocused=False (roots are never the focused session), so without this it
            would render as StateTextStyle's plain muted-idle look. Root paths get their own
            emphasis instead - bold and full-brightness text - so the directory a user is looking at
            reads as the most prominent thing in its own subtree.
        -->
        <Style x:Key="TreeRowNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StateTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Root">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!--
        P1-T1b scaffolding only: placeholder panels, no data binding, no behavior. Layout per the
        project plan - menu bar across the top; below it a horizontal split into panel A (left,
        session tree) / center area / panel B (right, file tree) via GridSplitters; the center
        area is itself split into a top area (panel C tab-strip + panel D content) over a bottom
        area (panel E, agent graph), also via a GridSplitter.

        MinWidth/MinHeight on every column/row (not just the splitters) is deliberate: without it
        a GridSplitter can be dragged - or, worse, a bad Auto/Star combination can render at -
        zero size, which a build success alone would not catch. See P1-T1b's verification notes
        for how this was checked (ActualWidth/ActualHeight measured after Show(), not just "it
        built").
    -->
    <Border x:Name="ChromeRoot" Background="{StaticResource BackgroundBaseBrush}">
    <DockPanel LastChildFill="True">

        <!--
            Custom title bar replacing the native OS caption entirely - see App/Theme.xaml's
            Window style (WindowStyle="None" + a matching WindowChrome) and MainWindow.xaml.cs's
            WindowProc maximize-to-work-area fix, which this borderless+maximizable window needs.
        -->
        <controls:CustomTitleBar DockPanel.Dock="Top" TitleText="Accel"
                                  VersionText="{x:Static controls:AppVersionInfo.DisplayText}" />

        <!--
            P4-T2: non-modal "rename may not have applied" warning banner (the plan's exact wording
            for what a rename's completion-poll timeout should surface - the write may well have
            landed even though the status file never confirmed a matching name within the timeout, so
            this deliberately never blocks the UI the way a MessageBox would). Collapsed by default;
            MainWindow.ShowTransientWarning sets the text and shows it, auto-hiding itself again after
            a few seconds via a DispatcherTimer.
        -->
        <Border x:Name="TransientWarningBanner" DockPanel.Dock="Top" Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
            <TextBlock x:Name="TransientWarningText" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource WarningTextBrush}" />
        </Border>

        <!-- Horizontal split: Panel A | splitter | center area | splitter | Panel B. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3*" MinWidth="240" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--
                Panel A - session tree (left). P1-T2 wires this to RootsPanelViewModel (set as
                PanelA's DataContext by MainWindow's constructor; null in the pure-scaffolding
                case, in which case the TreeView simply renders empty). Presentation is
                deliberately plain here - glyphs, model/effort badges, column alignment and the
                IsRunning x IsFocused visual states are P1-T4's job. This only has to prove the
                data path: feed -> ViewModel -> bound TreeView.
            -->
            <Border x:Name="PanelA" Grid.Column="0" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceBrush}">
                <!--
                    Panel A is split over the session tree and the MCP/SKILLS hit-count mini-panels,
                    independently resizable - the same top/splitter/bottom Grid panel B already uses
                    for FILES over GIT. The bottom row's 5*/1* ratio and MinHeight/MaxHeight
                    (88/220) deliberately mirror the center column's own top/bottom split around
                    Panel E (agent graph) below, so the MCP/SKILLS panel renders at the same default
                    height as Panel E - the two sit side by side visually and looked mismatched
                    otherwise. The two mini-panels share one McpSkillsPanelViewModel (set as both
                    McpSectionRoot's and SkillsSectionRoot's DataContext by MainWindow's
                    constructor): one focused-session lookup feeding two collections, never a
                    filtered view of panel A's own RootsPanelViewModel.
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" MinHeight="88" MaxHeight="220" />
                    </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Border DockPanel.Dock="Top" Margin="16,16,16,10" Style="{StaticResource SectionHeaderBackdropStyle}">
                        <TextBlock Text="SESSIONS" Style="{StaticResource SectionHeaderTextStyle}" />
                    </Border>

                    <!--
                        P1-T3b: minimal add/remove toolbar. "Add root…" prompts for a folder,
                        creates it on disk if missing, and appends it to accel-folders.json.
                        Remove is scoped to a selected root node via the tree's context menu below
                        (right-click a root row) rather than a toolbar button, since it needs a
                        target node - see RootsPanelViewModel.RemoveRootCommand.
                    -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,12">
                        <Button Content="+  Add root" Command="{Binding AddRootCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Feed status / counts: makes "working but empty" visibly different from "broken". -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <StackPanel>
                            <TextBlock x:Name="PanelAStatus" TextWrapping="Wrap"
                                       Style="{StaticResource SecondaryTextStyle}" Foreground="{StaticResource TealBrush}"
                                       Text="{Binding StatusText}"
                                       Visibility="{Binding NoSnapshot, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{StaticResource TealBrush}" />
                                    <TextBlock Margin="4,0,0,0" Style="{StaticResource SecondaryTextStyle}"
                                               Foreground="{StaticResource TealBrush}">
                                        <Run Text="{Binding RootCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" /><Run Text=" root(s), " />
                                        <Run Text="{Binding SessionCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" /><Run Text=" session(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{StaticResource TealBrush}" />
                                    <TextBlock Margin="4,0,0,0" Style="{StaticResource SecondaryTextStyle}"
                                               Foreground="{StaticResource TealBrush}">
                                        <Run Text="{Binding LiveSessionCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" /><Run Text=" running — Refreshed at " />
                                        <Run Text="{Binding RefreshedAtValueText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        HorizontalScrollBarVisibility="Disabled": every row already ellipsis-trims
                        into the Grid's Star-width name column instead of needing to scroll to read
                        it (see the row template below), so a horizontal scrollbar here only ever
                        got in the way - selecting a row auto-scrolls the TreeView's internal
                        ScrollViewer to bring the selected TreeViewItem fully into view, which
                        included horizontal scroll for any row wider than the viewport, producing an
                        unwanted sideways jump on every click. Disabling it forces genuine (already
                        intended) clipping/ellipsis instead of ever letting that scroll exist.
                    -->
                    <TreeView x:Name="RootsTreeView" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
                              Padding="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <!--
                                Two-way IsExpanded/IsSelected: the ViewModel is the authority on both
                                (it re-applies them after every rebuild, keyed on the stable
                                root-path / session-id / agent-id), and the user's own
                                expand/collapse/select gestures flow back into it through these
                                bindings - so the next rebuild preserves them.

                                Tag is stashed with the panel's own DataContext (the
                                RootsPanelViewModel) purely so the per-item ContextMenu below - a
                                separate visual tree that can't see this TreeViewItem's ancestors -
                                can still reach RemoveRootCommand via PlacementTarget.Tag.
                            -->
                            <!--
                                BasedOn the theme's implicit TreeViewItem style: an
                                ItemContainerStyle REPLACES the implicit style outright rather
                                than layering on top of it, so without this the tree would silently
                                fall back to WPF's stock (native-triangle, square-selection)
                                template while every other control used the new theme.
                            -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext}" />
                                <!--
                                    Stretch (not the TreeViewItem default of Left) so each row's
                                    Grid below actually fills the available tree width instead of
                                    sizing to content - that Star-width name column is what lets
                                    the Name text's ellipsis respond to the real panel width when
                                    the user drags the panel-A/center-area GridSplitter, instead of
                                    truncating at a fixed pixel count regardless of how wide the
                                    panel actually is.
                                -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!--
                                    P1-T4 hard accessibility requirement: every row's state is
                                    also exposed as a plain text description for screen readers,
                                    not just via glyph/weight/colour - see
                                    RootsPanelNodeViewModel.AutomationDescription (already includes
                                    the running/focused text SessionVisualStateResolver produces).
                                -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationDescription}" />
                                <!--
                                    Hover tooltip: session id + context-window size, both already
                                    on Columns (P1-T4 requirement 4) - see
                                    RootsPanelNodeViewModel.TooltipText.
                                -->
                                <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                                <!--
                                    Double-click: attach (resume) a sleeping session, or confirm-then-stop
                                    a running one - see MainWindow.SessionRow_MouseDoubleClick, which
                                    no-ops (and leaves the TreeView's own expand/collapse toggle alone) for
                                    every row Kind other than Session.
                                -->
                                <EventSetter Event="MouseDoubleClick" Handler="SessionRow_MouseDoubleClick" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <!--
                                                Kind-gated (each item/separator below defaults to
                                                Collapsed and only turns Visible for the row kind it
                                                actually applies to - a root row and a session row
                                                never show the other's actions, e.g. "Create session"/
                                                "Stop monitoring" only make sense over a root, and
                                                "Rename"/"Resume"/"Remove" only over a session). An
                                                agent/placeholder row's menu is intentionally empty:
                                                neither group applies to it.

                                                This is the only way to reach "Create session" now
                                                that the top menu bar is gone - see
                                                CreateSessionAtRoot_Click's doc comment.
                                            -->
                                            <MenuItem Header="Create session…">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="CreateSessionAtRoot_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Root">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <!--
                                                Opens a tab hosting a plain, unmanaged shell (cmd.exe)
                                                rooted at this folder - MainWindow.OpenTerminalAtRoot_Click
                                                / PtySession.CreateShellSpec. Entirely unrelated to
                                                Claude Code: no session id, no transcript, the new
                                                tab never becomes a panel A row. Icon/colour
                                                (WarningTextBrush) match TabViewModel.IconGlyph/
                                                IconColorHex's own Shell-kind choice, so the menu item
                                                previews the tab's own "different look".
                                            -->
                                            <MenuItem Header="Open terminal here…">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Foreground="{StaticResource WarningTextBrush}" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="OpenTerminalAtRoot_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Root">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <!--
                                                Reveals this root folder in a new Windows Explorer
                                                window - MainWindow.RevealRootInExplorer_Click. Plain
                                                OS-level convenience, no relationship to any session/
                                                tab/PtySession at all.
                                            -->
                                            <MenuItem Header="Reveal in File Explorer">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="RevealRootInExplorer_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Root">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <Separator>
                                                <Separator.Style>
                                                    <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Root">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Separator.Style>
                                            </Separator>
                                            <!--
                                                RemoveRootCommand itself is also a no-op for a
                                                session/agent/placeholder node (see its own guard
                                                clause) - this Visibility trigger is the visual half
                                                of that same guard, not a replacement for it.
                                            -->
                                            <MenuItem Header="Stop monitoring this folder…"
                                                      Command="{Binding PlacementTarget.Tag.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Root">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <!--
                                                P4-T2/T4: the code-behind handlers below also guard on
                                                Kind == Session (same convention as RemoveRootCommand
                                                above) - this Visibility trigger is the visual half of
                                                that same guard, not a replacement for it.

                                                An inline Click="..." attribute directly on a MenuItem
                                                nested this deep (ContextMenu inside a Style's Setter.Value)
                                                miscompiles under the WPF markup compiler here - the
                                                generated IComponentConnector.Connect ends up casting the
                                                target to the unrelated sibling GridSplitter instead of
                                                MenuItem (reproduced twice against a fully clean obj/bin,
                                                so it is a real compiler defect for this specific nesting
                                                shape, not a stale-build artifact). Each item below uses a
                                                per-MenuItem Style + EventSetter instead - the exact
                                                pattern already proven working for the tab strip's
                                                double-click gesture - which sidesteps whatever in the
                                                compiler's connectionId numbering trips on the inline
                                                attribute form.
                                            -->
                                            <MenuItem Header="Rename…">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="RenameSession_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Session">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Resume">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="ResumeSession_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Session">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Resume as fork…">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="ResumeSessionAsFork_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Session">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <!--
                                                Edits App\Services\SessionResumeArgsStore's per-session
                                                entry - flags appended the next time this session id is
                                                resumed (see MainWindow.EditSessionArgs_Click). Does not
                                                touch an already-running `claude` process's own argv,
                                                which cannot change once launched.
                                            -->
                                            <MenuItem Header="Edit launch args…">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="EditSessionArgs_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Session">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <Separator>
                                                <Separator.Style>
                                                    <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Session">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Separator.Style>
                                            </Separator>
                                            <!--
                                                Remove: disabled (refused, fail-closed) while the session is
                                                running per locked-in decision 4 / risk register item 3 -
                                                see MainWindow.RemoveSession_Click. Recycle-bin only from
                                                this menu; there is deliberately no UI path to
                                                SessionRemovalMode.PermanentDelete.
                                            -->
                                            <MenuItem Header="Remove…">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Tag" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <EventSetter Event="MenuItem.Click" Handler="RemoveSession_Click" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="Session">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!--
                                        "Waiting for feedback" (RootsPanelNodeViewModel.IsWaiting) - see
                                        WaitingRowBackgroundBrush/WaitingRowBorderBrush's doc comment above.
                                        Only ever true for a Session row.
                                    -->
                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WaitingRowBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WaitingRowBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!--
                                    Grid, not a StackPanel: a StackPanel always sizes itself (and
                                    every child) to content, so the old fixed MaxWidth="160" on the
                                    name TextBlock below was the only thing that ever ellipsized it
                                    - it neither grew to use extra space when panel A was widened
                                    nor shrank correctly when narrowed. The Name column here is the
                                    Grid's one Star-width column, so it actually tracks panel A's
                                    real width (set by the GridSplitter) in both directions.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        Model badge: letter-in-chip (O/S/H/F/?), coloured by model
                                        family - see ModelBadgeTable. Hidden for root/placeholder
                                        rows (ShowModelBadge=false), which have no model.
                                    -->
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0"
                                            Background="{Binding ModelBadge.ColorHex, Converter={StaticResource HexToBrush}}"
                                            Visibility="{Binding ShowModelBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ModelBadge.Letter}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!--
                                        Effort bars: 1-4 stacked signal bars next to the model
                                        badge - see EffortBarLevel/EffortBarsControl.
                                    -->
                                    <controls:EffortBarsControl Grid.Column="1" Level="{Binding EffortLevel}" Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowEffortBars, Converter={StaticResource BoolToVis}}" />

                                    <!--
                                        Name column: the Grid's Star-width column, so it actually
                                        grows/shrinks with panel A's real width - ellipsis-truncated
                                        (requirement 4) rather than wrapping/clipping raw, so long
                                        session names don't blow out the row height. DisplayText is
                                        the plain name only (no id/model/effort baked in for
                                        root/session rows - see RootsPanelNodeViewModel.DisplayText);
                                        that per-session detail now lives in the row's ToolTip
                                        (TooltipText, set on the TreeViewItem itself above). A root
                                        row's own "(N sessions, M running)" summary is different: it
                                        describes this row's children, not a single session's detail,
                                        so it stays visible as a second, deliberately un-emphasized
                                        Run right after the bold path (RootSummarySuffix is empty for
                                        every non-root row).
                                    -->
                                    <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource TreeRowNameTextStyle}">
                                        <Run Text="{Binding DisplayText, Mode=OneWay}" />
                                        <Run Text="{Binding RootSummarySuffix, Mode=OneWay}"
                                             FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource SplitterBrush}" ResizeBehavior="PreviousAndNext" />

                    <!--
                        MCP (left half) and SKILLS (right half) hit counts for the focused session,
                        split by a vertical GridSplitter of the same 4px/SplitterBrush kind the
                        window's own column splitters use. Both halves bind to the same
                        McpSkillsPanelViewModel instance; only the collection differs.
                    -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="McpSectionRoot" Grid.Column="0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top" Margin="16,12,8,8" Style="{StaticResource SectionHeaderBackdropStyle}">
                                    <TextBlock Text="MCP" Style="{StaticResource SectionHeaderTextStyle}" />
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,4,8">
                                    <StackPanel>
                                        <TextBlock Text="No MCP calls yet." Margin="8,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding McpUsage.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding McpUsage}" ItemTemplate="{StaticResource ToolUsageRowTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{StaticResource SplitterBrush}" ResizeBehavior="PreviousAndNext" />

                        <Border x:Name="SkillsSectionRoot" Grid.Column="2">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top" Margin="8,12,16,8" Style="{StaticResource SectionHeaderBackdropStyle}">
                                    <TextBlock Text="SKILLS" Style="{StaticResource SectionHeaderTextStyle}" />
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="No skills used yet." Margin="8,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SkillUsage.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding SkillUsage}" ItemTemplate="{StaticResource ToolUsageRowTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource SplitterBrush}" ResizeBehavior="PreviousAndNext" />

            <!-- Center area: top (Panel C tab-strip + Panel D content) split over bottom (Panel E, agent graph). -->
            <Grid Grid.Column="2">
                <!--
                    Panel E (agent graph) defaults to a smaller share of the center area than the
                    terminal above it - still fully resizable via the GridSplitter. MinHeight="88" =
                    Padding + CardHeight + Padding (76, AgentGraphLayoutOptions' defaults) plus the
                    panel's own header line, so one card row always fits; MaxHeight="220" yields
                    AgentGraphLayout.Compute's RowsPerColumn == 3 (design doc "claude-agentgraph.md" §7.2).
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" MinHeight="120" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="1*" MinHeight="88" MaxHeight="220" />
                </Grid.RowDefinitions>

                <!-- Top area: Panel C tab-strip above Panel D content. -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="44" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!--
                        Panel C - the tab strip (P3-T1), bound to TabsViewModel (set as PanelC's
                        DataContext by MainWindow's constructor; null in the scaffolding case, where
                        the empty-state hint below is what renders).

                        A horizontal ListBox rather than a TabControl: panel D's content is a single
                        shared TerminalView reattached per selection (see TabsViewModel's class
                        remarks - a TabControl would want one content element per tab, i.e. one
                        WebView2 per tab), so what is needed here is selection only, which is
                        exactly what a ListBox with SelectedItem two-way bound gives. Visual polish
                        (real tab shapes, close-on-middle-click, drag reorder) is explicitly not in
                        P3-T1's scope.
                    -->
                    <Border x:Name="PanelC" Grid.Row="0" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceElevatedBrush}">
                        <Grid>
                            <TextBlock Text="No sessions open" Margin="16,0" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                            <ListBox x:Name="TabsList" ItemsSource="{Binding Tabs}"
                                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="8,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <!--
                                        BasedOn the theme's pill-shaped tab container (see
                                        Theme.xaml's TabItemContainerStyle): an ItemContainerStyle
                                        replaces rather than layers over the implicit style, so the
                                        look has to be inherited explicitly here while this style
                                        keeps its own automation/gesture setters.
                                    -->
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TabItemContainerStyle}">
                                        <!--
                                            Same accessibility rule as panel A (P1-T4): the tab's
                                            state is exposed as text, never only as styling - see
                                            TabViewModel.AutomationDescription.
                                        -->
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationDescription}" />
                                        <!--
                                            P4-T5: double-click a tab to stop its session - distinct
                                            from the close (✕) button, which removes the tab outright.
                                            MainWindow.TabItem_MouseDoubleClick confirms, then calls
                                            TabsViewModel.StopTabCommand, which kills the session but
                                            keeps the tab (frozen scrollback + exit banner - see that
                                            command's own remarks). Control.MouseDoubleClick is a real
                                            routed event on every Control, ListBoxItem included.
                                        -->
                                        <EventSetter Event="Control.MouseDoubleClick" Handler="TabItem_MouseDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!--
                                                Every tab kind gets its own leading glyph (see
                                                TabViewModel.IconGlyph/IconColorHex's own remarks for
                                                the full set: Session/File/single-pane GIT/GIT diff) so
                                                all four read as visually distinct at a glance, never
                                                colour-only (Title's own foreground below also differs
                                                per kind). One TextBlock bound to the computed
                                                glyph/colour rather than one per kind, so a fifth kind
                                                later only needs a new switch arm, not new XAML.
                                            -->
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                                       Visibility="{Binding IconGlyph, Converter={StaticResource StringToVis}}" />
                                            <TextBlock Text="{Binding Title}" MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                                                        <Style.Triggers>
                                                            <!-- Ended tabs stay in the strip (never vanish silently) but read as inactive. -->
                                                            <DataTrigger Binding="{Binding HasEnded}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                            <!-- A file/git-change/shell tab's own "different look" - the
                                                                 leading glyph above already carries the same distinction
                                                                 as text/AutomationDescription. -->
                                                            <DataTrigger Binding="{Binding IsFileTab}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsGitChangeTab}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsShellTab}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding StatusSuffix}" Margin="8,0,0,0"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <!--
                                                Close goes through TabsViewModel.CloseTabCommand, which
                                                branches on Kind: a session tab closes through
                                                PtyRegistry.CloseAsync (nothing in the ViewModel layer
                                                can dispose a PtySession - it never holds one), a file
                                                tab is just removed (it never had one to begin with).
                                            -->
                                            <Button Content="✕" Margin="10,0,0,0"
                                                    Style="{StaticResource TabCloseButtonStyle}"
                                                    ToolTip="Close this tab"
                                                    AutomationProperties.Name="Close tab"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!--
                        Panel D content: the WebView2-hosted xterm.js terminal, attached to a live
                        PTY per selected tab (see TabsViewModel.AttachTerminalAsync, wired in
                        MainWindow's constructor). x:Name="Terminal" is also used by
                        Program.cs's `terminal-e2e-smoke-test` dev verb to await
                        TerminalView.Initialization and query document.title for proof the page
                        actually loaded.
                    -->
                    <Border x:Name="PanelD" Grid.Row="1" Background="{StaticResource BackgroundBaseBrush}">
                        <Grid>
                            <controls:TerminalView x:Name="Terminal" />

                            <!--
                                Read-only file viewer (panel B's FILES tree double-click gesture - see
                                MainWindow.FilesTreeViewItem_MouseDoubleClick / TabsViewModel.ShowFileAsync).
                                Declared after Terminal so it paints on top, fully covering it, while
                                Collapsed; toggled Visible instead of swapping Terminal out, since the
                                underlying pty stays attached (just hidden) rather than being torn down
                                and reattached on every flip between a file tab and a session tab.
                            -->
                            <Border x:Name="FileViewerHost" Background="{StaticResource BackgroundBaseBrush}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        Line-number gutter. Kept in lock-step with FileViewerText's scroll
                                        position via the TranslateTransform below, updated in
                                        MainWindow.xaml.cs's FileViewerText_ScrollChanged - see that
                                        handler's remarks for why a transform offset (not a second
                                        ScrollViewer) is used to sync it. The TextBlock is wrapped in a
                                        Canvas (rather than sitting directly in this Border) so it is
                                        measured with unconstrained height: a Border/Grid cell would
                                        otherwise arrange - and WPF would then auto-clip - the TextBlock to
                                        the (much shorter) viewport height, baking that clip into the
                                        TextBlock's own visual before TranslateTransform is applied, so
                                        scrolling would only ever slide that already-truncated first
                                        "page" of numbers around instead of revealing the rest of the
                                        file. The column's fixed width (rather than Auto) is required by
                                        the same fix: an Auto column would size itself from the Canvas's
                                        own (always-zero) desired size instead of the TextBlock's.
                                    -->
                                    <Border Grid.Column="0" ClipToBounds="True" Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0">
                                        <Canvas>
                                            <TextBlock x:Name="FileViewerLineNumbers" FontFamily="Consolas"
                                                       FontSize="{StaticResource FontSizeBody}" Padding="8,16,8,16"
                                                       TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}"
                                                       IsHitTestVisible="False" Width="64">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="FileViewerLineNumbersTransform" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Canvas>
                                    </Border>

                                    <!--
                                        RichTextBox (not a plain TextBox) so MainWindow.ShowFileTabAsync can
                                        colour tokens per SyntaxHighlighter.Tokenize - a TextBox has no way
                                        to colour part of its own text. Its own scrollbars are used directly
                                        (no wrapping ScrollViewer) since RichTextBox already provides both.
                                    -->
                                    <RichTextBox x:Name="FileViewerText" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBody}"
                                                 Padding="16" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 AutomationProperties.Name="File content (read-only)" />
                                </Grid>
                            </Border>

                            <!--
                                Side-by-side read-only diff viewer for a Modified git-change tab (panel
                                B's GIT section double-click - see MainWindow.GitChangeRow_MouseLeftButtonDown
                                / TabsViewModel.ShowGitDiffTabAsync). Same overlay convention as
                                FileViewerHost above (declared after it so it paints on top while
                                Visible; the two are mutually exclusive - MainWindow.ShowFileTabAsync/
                                ShowGitDiffTabAsync toggle one and collapse the other).
                            -->
                            <Border x:Name="DiffViewerHost" Background="{StaticResource BackgroundBaseBrush}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <TextBlock Text="Before" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <TextBlock Text="After" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                                    </Border>

                                    <!-- "Before" side's line-number gutter - see FileViewerLineNumbers's comment for how it stays in sync. -->
                                    <Border Grid.Row="1" Grid.Column="0" ClipToBounds="True" Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0">
                                        <Canvas>
                                            <TextBlock x:Name="DiffOldLineNumbers" FontFamily="Consolas"
                                                       FontSize="{StaticResource FontSizeBody}" Padding="8,16,8,16"
                                                       TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}"
                                                       IsHitTestVisible="False" Width="64">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="DiffOldLineNumbersTransform" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Canvas>
                                    </Border>

                                    <RichTextBox x:Name="DiffOldText" Grid.Row="1" Grid.Column="1"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBody}"
                                                 Padding="16" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 AutomationProperties.Name="Before (read-only)" />

                                    <GridSplitter Grid.Row="1" Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" Background="{StaticResource SplitterBrush}"
                                                  ResizeBehavior="PreviousAndNext" />

                                    <!-- "After" side's line-number gutter. -->
                                    <Border Grid.Row="1" Grid.Column="3" ClipToBounds="True" Background="{StaticResource SurfaceElevatedBrush}"
                                            BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0">
                                        <Canvas>
                                            <TextBlock x:Name="DiffNewLineNumbers" FontFamily="Consolas"
                                                       FontSize="{StaticResource FontSizeBody}" Padding="8,16,8,16"
                                                       TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}"
                                                       IsHitTestVisible="False" Width="64">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="DiffNewLineNumbersTransform" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Canvas>
                                    </Border>

                                    <RichTextBox x:Name="DiffNewText" Grid.Row="1" Grid.Column="4"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBody}"
                                                 Padding="16" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 AutomationProperties.Name="After (read-only)" />

                                    <!--
                                        "After" side's diff-mark overview strip: a thin always-visible ruler
                                        (green = an added/changed line at this position, red = old lines were
                                        removed just before this position), one mark per DiffNewText source
                                        line, scaled to the strip's full height regardless of scroll position
                                        - so the whole file's change layout is visible at a glance, the same
                                        idea as an editor's scrollbar overview ruler. Populated by
                                        MainWindow.xaml.cs's RenderDiffMarkStrip.
                                    -->
                                    <Canvas x:Name="DiffMarkStrip" Grid.Row="1" Grid.Column="5" Background="{StaticResource SurfaceElevatedBrush}"
                                            IsHitTestVisible="False" ClipToBounds="True" SizeChanged="DiffMarkStrip_SizeChanged" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource SplitterBrush}" ResizeBehavior="PreviousAndNext" />

                <!--
                    Bottom area: Panel E, agent graph (Phase 6). DataContext is a real
                    AgentGraphViewModel - a second ITelemetryFeed/ISessionSelectionService reader,
                    never a filtered view of panel A's RootsPanelViewModel (design doc
                    "claude-agentgraph.md" §7.1). The header row's caption (StatusText) always shows
                    even while a stale-but-visible graph is rendered (§7.5).
                -->
                <Border x:Name="PanelE" Grid.Row="2" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceBrush}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,0">
                            <Border Style="{StaticResource SectionHeaderBackdropStyle}" VerticalAlignment="Center">
                                <TextBlock Text="AGENT GRAPH" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <controls:AgentGraphControl x:Name="AgentGraph" Nodes="{Binding Nodes}" Margin="4,0,4,4" />
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource SplitterBrush}" ResizeBehavior="PreviousAndNext" />

            <!--
                Panel B - file tree + git status (right). Split 2/3 (file tree, Phase 5) over 1/3
                (git status list, Phase 7), independently resizable via the GridSplitter between
                them. Each section gets its own DataContext (FilesSectionRoot / GitSectionRoot, set
                by MainWindow's constructor) rather than one shared DataContext on PanelB itself -
                FilesPanelViewModel and GitPanelViewModel are two distinct ViewModels that happen to
                resolve the same focused-folder root (FocusedRootResolver), not one VM split across
                two views.
            -->
            <Border x:Name="PanelB" Grid.Column="4" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!--
                        File tree section (Phase 5). Real FilesPanelViewModel (set as
                        FilesSectionRoot's DataContext): a read-only hierarchy rooted at whichever
                        folder is currently focused (a session's cwd, or panel A's own tree
                        selection - see FilesPanelViewModel's remarks). No context menu, no
                        IsSelected binding, no file-open action - the only interaction this tree
                        supports is a folder's own expand/collapse. The bottom "focused folder"
                        status caption Phase 5 originally had here was dropped once the git section
                        below took over naming the focused root for panel B as a whole.
                    -->
                    <DockPanel x:Name="FilesSectionRoot" Grid.Row="0" LastChildFill="True">
                        <Border DockPanel.Dock="Top" Margin="16,16,16,10" Style="{StaticResource SectionHeaderBackdropStyle}">
                            <TextBlock Text="FILES" Style="{StaticResource SectionHeaderTextStyle}" />
                        </Border>

                        <TreeView x:Name="FilesTreeView" ItemsSource="{Binding Nodes}" BorderThickness="0" Background="Transparent"
                                  Padding="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <!-- Two-way: the user's own expand/collapse gestures are the only
                                         interaction this tree supports (Phase 5 scope). -->
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationDescription}" />
                                    <Setter Property="ToolTip" Value="{Binding Key}" />
                                    <!--
                                        Double-clicking a file row opens (or selects) its read-only tab
                                        in panel C/D - see MainWindow.FilesTreeViewItem_MouseDoubleClick,
                                        which guards on IsDirectory so a folder row's double-click still
                                        only expands/collapses it (this event bubbles through every
                                        ancestor TreeViewItem, same tolerant pattern as panel A's
                                        SessionRow_MouseDoubleClick).
                                    -->
                                    <EventSetter Event="MouseDoubleClick" Handler="FilesTreeViewItem_MouseDoubleClick" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Fixed-width icon slot so every row's name starts at the same
                                             x-offset, whether or not this entry has an extension icon
                                             (IconLabel empty) - the border itself always occupies the
                                             slot; only its fill/label are conditional. -->
                                        <Border VerticalAlignment="Center" CornerRadius="2" Padding="3,0" Width="18"
                                                Margin="0,0,4,0"
                                                Background="{Binding IconColorHex, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding IconLabel}" FontSize="8" FontWeight="Bold"
                                                       Foreground="#FF1A1A1A" HorizontalAlignment="Center"
                                                       Visibility="{Binding IconLabel, Converter={StaticResource StringToVis}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                    <Style.Triggers>
                                                        <!-- Folder vs file distinction never relies on colour
                                                             alone - the TreeView's own expand arrow already
                                                             differs, and AutomationDescription above carries
                                                             the same distinction as text. -->
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <!-- Applied after the directory trigger so a hidden
                                                             directory (e.g. ".git") still reads as dimmed,
                                                             not bright-bold. TextMutedBrush (not
                                                             TextDisabledBrush) so hidden entries stay
                                                             legible instead of nearly invisible. -->
                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource SplitterBrush}" ResizeBehavior="PreviousAndNext" />

                    <!--
                        Git status section (Phase 7). Real GitPanelViewModel (set as
                        GitSectionRoot's DataContext): a flat, read-only `git status` list for the
                        same focused root the file tree above resolves, grouped into "Staged
                        Changes" / "Changes" like VS Code's Source Control view. No stage/commit/
                        push action yet - list-only, same restraint the file tree applies.
                    -->
                    <DockPanel x:Name="GitSectionRoot" Grid.Row="2" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionHeaderBackdropStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="GIT" Style="{StaticResource SectionHeaderTextStyle}" />
                                </Border>
                                <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding HasRepo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{StaticResource TealBrush}" />
                                <TextBlock Text="{Binding RepoName}" Margin="4,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                <TextBlock Text="&#xE7BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TealBrush}" />
                                <TextBlock Text="{Binding RemoteBranchText}" Margin="4,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding HasRepo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{StaticResource TealBrush}" />
                                <TextBlock Margin="4,0,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TealBrush}">
                                    <Run Text="{Binding ChangesCountText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" /><Run Text=" change(s)" />
                                </TextBlock>
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TealBrush}"
                                           Visibility="{Binding PendingPushSummaryText, Converter={StaticResource StringToVis}}" />
                                <TextBlock Margin="4,0,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TealBrush}"
                                           Visibility="{Binding PendingPushSummaryText, Converter={StaticResource StringToVis}}">
                                    <Run Text="{Binding PendingPushCountText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" /><Run Text=" commit(s) to push" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                            <StackPanel>
                                <TextBlock Text="STAGED CHANGES" Margin="8,4"
                                           Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold"
                                           Visibility="{Binding StagedChanges.Count, Converter={StaticResource CountToVis}}" />
                                <ItemsControl ItemsSource="{Binding StagedChanges}" ItemTemplate="{StaticResource GitChangeRowTemplate}" />

                                <TextBlock Text="CHANGES" Margin="8,4"
                                           Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold"
                                           Visibility="{Binding Changes.Count, Converter={StaticResource CountToVis}}" />
                                <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource GitChangeRowTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
