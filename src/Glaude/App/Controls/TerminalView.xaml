<UserControl x:Class="Glaude.App.Controls.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!--
        P2-T5: WebView2-hosted xterm.js terminal - renders an inert (no PTY) terminal only. See
        TerminalView.xaml.cs for CoreWebView2 initialization (user-data folder,
        SetVirtualHostNameToFolderMapping, navigation to the vendored index.html). Wiring this up
        to a live claude session over /pty/{tabId} is the separate, later task P2-T5b.
    -->
    <Grid Background="#FF1E1E1E">
        <wv2:WebView2 x:Name="Browser" />
    </Grid>
</UserControl>
