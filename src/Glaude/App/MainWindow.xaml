<Window x:Class="Glaude.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Glaude.App.Converters"
        xmlns:controls="clr-namespace:Glaude.App.Controls"
        Title="Glaude" Height="720" Width="1200"
        Language="">
    <!--
        P1-T4: the project sets InvariantGlobalization (Glaude.csproj) for the self-contained
        publish, which strips the culture tables WPF's default FrameworkElement.Language
        ("en-US") needs to resolve a "specific culture" for. Any data-bound value converter
        (HexToBrushConverter, BooleanToVisibilityConverter - both newly introduced by this task's
        badges/glyphs) triggers that resolution the very first time its binding activates,
        throwing XamlParseException("Cannot find non-neutral culture related to 'en-us'") the
        moment the row template is measured - repro'd via "ui-preview verify". The Language=""
        attribute above avoids the lookup entirely rather than asking WPF to resolve a language
        this build has no culture data for.
    -->
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            P1-T4 / locked-in decision 9: panel A's four IsRunning x IsFocused visual states.
            These brushes' colours must stay in sync with SessionVisualStateResolver's
            *ColorHex constants (the tested, WPF-free single source of truth for the mapping) -
            they are duplicated here rather than referenced via {x:Static} only because
            SolidColorBrush construction from a plain string constant still needs a XAML-side
            colour literal; ModelBadgeTableTests/SessionVisualStateResolverTests pin the C# side
            down, and RootsPanelNodeViewModelTests covers the AutomationDescription text this
            style's Triggers are matched against.
        -->
        <SolidColorBrush x:Key="RunningFocusedBrush" Color="#FF1565C0" />
        <SolidColorBrush x:Key="RunningBrush" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="IdleFocusedBrush" Color="#FF5C6BC0" />
        <SolidColorBrush x:Key="IdleBrush" Color="#FF757575" />

        <!--
            Never color-only (hard accessibility requirement): FontWeight carries IsFocused
            (Bold vs Normal) independently of the Foreground colour, and the glyph shape below
            (filled vs hollow, driven by its own DataTrigger on IsRunning) carries IsRunning
            independently of both. Removing colour entirely (e.g. a high-contrast theme) still
            leaves all four states distinguishable via glyph shape + weight alone.
        -->
        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRunning}" Value="True" />
                        <Condition Binding="{Binding IsFocused}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource RunningFocusedBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRunning}" Value="True" />
                        <Condition Binding="{Binding IsFocused}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{StaticResource RunningBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRunning}" Value="False" />
                        <Condition Binding="{Binding IsFocused}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource IdleFocusedBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!--
        P1-T1b scaffolding only: placeholder panels, no data binding, no behavior. Layout per the
        project plan - menu bar across the top; below it a horizontal split into panel A (left,
        session tree) / center area / panel B (right, file tree) via GridSplitters; the center
        area is itself split into a top area (panel C tab-strip + panel D content) over a bottom
        area (panel E, agent graph), also via a GridSplitter.

        MinWidth/MinHeight on every column/row (not just the splitters) is deliberate: without it
        a GridSplitter can be dragged - or, worse, a bad Auto/Star combination can render at -
        zero size, which a build success alone would not catch. See P1-T1b's verification notes
        for how this was checked (ActualWidth/ActualHeight measured after Show(), not just "it
        built").
    -->
    <DockPanel LastChildFill="True">

        <!-- Menu bar across the top. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_View" />
            <MenuItem Header="_Help" />
        </Menu>

        <!-- Horizontal split: Panel A | splitter | center area | splitter | Panel B. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="220" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <!--
                Panel A - session tree (left). P1-T2 wires this to RootsPanelViewModel (set as
                PanelA's DataContext by MainWindow's constructor; null in the pure-scaffolding
                case, in which case the TreeView simply renders empty). Presentation is
                deliberately plain here - glyphs, model/effort badges, column alignment and the
                IsRunning x IsFocused visual states are P1-T4's job. This only has to prove the
                data path: feed -> ViewModel -> bound TreeView.
            -->
            <Border x:Name="PanelA" Grid.Column="0" BorderBrush="#FF808080" BorderThickness="0,0,1,0" Background="#FFF3F3F3">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Panel A — Sessions" Margin="8,6,8,2" FontWeight="Bold" />

                    <!--
                        P1-T3b: minimal add/remove toolbar. "Add root…" prompts for a folder,
                        creates it on disk if missing, and appends it to glaude-folders.json.
                        Remove is scoped to a selected root node via the tree's context menu below
                        (right-click a root row) rather than a toolbar button, since it needs a
                        target node - see RootsPanelViewModel.RemoveRootCommand.
                    -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,4">
                        <Button Content="Add root…" Command="{Binding AddRootCommand}" Padding="6,2" />
                    </StackPanel>

                    <!-- Feed status / counts: makes "working but empty" visibly different from "broken". -->
                    <TextBlock x:Name="PanelAStatus" DockPanel.Dock="Bottom" Margin="8,2,8,6" TextWrapping="Wrap"
                               FontSize="10" Foreground="#FF505050" Text="{Binding StatusText}" />

                    <TreeView x:Name="RootsTreeView" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <!--
                                Two-way IsExpanded/IsSelected: the ViewModel is the authority on both
                                (it re-applies them after every rebuild, keyed on the stable
                                root-path / session-id / agent-id), and the user's own
                                expand/collapse/select gestures flow back into it through these
                                bindings - so the next rebuild preserves them.

                                Tag is stashed with the panel's own DataContext (the
                                RootsPanelViewModel) purely so the per-item ContextMenu below - a
                                separate visual tree that can't see this TreeViewItem's ancestors -
                                can still reach RemoveRootCommand via PlacementTarget.Tag.
                            -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext}" />
                                <!--
                                    P1-T4 hard accessibility requirement: every row's state is
                                    also exposed as a plain text description for screen readers,
                                    not just via glyph/weight/colour - see
                                    RootsPanelNodeViewModel.AutomationDescription (already includes
                                    the running/focused text SessionVisualStateResolver produces).
                                -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationDescription}" />
                                <!--
                                    Hover tooltip: session id + context-window size, both already
                                    on Columns (P1-T4 requirement 4) - see
                                    RootsPanelNodeViewModel.TooltipText.
                                -->
                                <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <!--
                                                Only meaningful for a root row; RemoveRootCommand
                                                itself is a no-op for session/agent/placeholder
                                                nodes (see its guard clause), so this is shown for
                                                every row rather than adding a Kind-based converter
                                                for this minimal, non-visual-polish task.
                                            -->
                                            <MenuItem Header="Stop monitoring this folder…"
                                                      Command="{Binding PlacementTarget.Tag.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <!--
                                        State glyph: filled "●" (running) vs hollow "○" (not
                                        running) - two overlapped TextBlocks whose Visibility is
                                        toggled by a DataTrigger on IsRunning, so the shape itself
                                        (not just colour) carries that half of the state. Both
                                        share StateTextStyle, so FontWeight/Foreground (the
                                        IsFocused half, plus the accent colour) apply to the glyph
                                        too, not only to the name text.
                                    -->
                                    <Grid Width="14" Margin="0,0,4,0">
                                        <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StateTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="○" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StateTextStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!--
                                        Model badge: letter-in-chip (O/S/H/F/?), coloured by model
                                        family - see ModelBadgeTable. Hidden for root/placeholder
                                        rows (ShowModelBadge=false), which have no model.
                                    -->
                                    <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,4,0"
                                            Background="{Binding ModelBadge.ColorHex, Converter={StaticResource HexToBrush}}"
                                            Visibility="{Binding ShowModelBadge, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Columns.Model}">
                                        <TextBlock Text="{Binding ModelBadge.Letter}" Foreground="White" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!--
                                        Effort bars: 1-4 stacked signal bars next to the model
                                        badge - see EffortBarLevel/EffortBarsControl.
                                    -->
                                    <controls:EffortBarsControl Level="{Binding EffortLevel}" Margin="0,0,6,0"
                                                                 Visibility="{Binding ShowEffortBars, Converter={StaticResource BoolToVis}}" />

                                    <!--
                                        Name column: ellipsis-truncated (requirement 4) rather than
                                        wrapping/clipping raw, so long session names don't blow out
                                        the row height or push the badges off the visible area.
                                    -->
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                               Style="{StaticResource StateTextStyle}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#FFCCCCCC" ResizeBehavior="PreviousAndNext" />

            <!-- Center area: top (Panel C tab-strip + Panel D content) split over bottom (Panel E, agent graph). -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="1*" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- Top area: Panel C tab-strip above Panel D content. -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PanelC" Grid.Row="0" BorderBrush="#FF808080" BorderThickness="0,0,0,1" Background="#FFE8E8E8">
                        <TextBlock Text="Panel C — Tabs" Margin="8,6" VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="PanelD" Grid.Row="1" Background="White">
                        <TextBlock Text="Panel D — Content" Margin="8" TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#FFCCCCCC" ResizeBehavior="PreviousAndNext" />

                <!-- Bottom area: Panel E, agent graph. -->
                <Border x:Name="PanelE" Grid.Row="2" BorderBrush="#FF808080" BorderThickness="0,1,0,0" Background="#FFF7F7F7">
                    <TextBlock Text="Panel E — Agent graph" Margin="8" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#FFCCCCCC" ResizeBehavior="PreviousAndNext" />

            <!-- Panel B - file tree (right). -->
            <Border x:Name="PanelB" Grid.Column="4" BorderBrush="#FF808080" BorderThickness="1,0,0,0" Background="#FFF3F3F3">
                <TextBlock Text="Panel B — Files" Margin="8" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
